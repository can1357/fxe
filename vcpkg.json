{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fxe",
  "version": "0.1.0",
  "description": "fxe — a small WebGPU/V8-based renderer",
  "dependencies": [
    "glm",
    {
      "name": "glfw3",
      "features": [
        { "name": "wayland", "platform": "linux" }
      ]
    },
    "stb",
    "nlohmann-json",
    "libuv",
    "libsodium",
    "zstd",
    "mbedtls",
    "nghttp2",
    "freetype",
    "harfbuzz",
    {
      "name": "fontconfig",
      "platform": "linux"
    },
    {
      "name": "sqlite3",
      "default-features": false,
      "features": ["json1", "fts5", "rtree", "math"]
    },
    "tree-sitter",
    "yoga",
    "pugixml",
    "giflib",
    {
      "name": "libpng",
      "features": ["apng"]
    },
    {
      "name": "libwebp",
      "features": ["anim"]
    },
    "libjpeg-turbo",
    "rlottie"
  ],
  "builtin-baseline": "6b07d2d37301e9e7c6fcf771536d2ff6585c5912"
}
